# Copy to .env and fill locally. Never commit the real key.
# W5 startup self-check only checks whether this file exists; it never reads or prints its contents.
# Required for creating/planning a task with the real model; opening the UI and offline tests do not need it.
DEEPSEEK_API_KEY=
# Model name used for planning/coding/review; deepseek-flash serves DeepSeek V4.1 Flash.
# Existing AGENT_MODEL overrides the default; restart the service after changing it.
# Provider default thinking mode is retained; reasoning is not exposed in UI events.
AGENT_MODEL=deepseek-flash
# Docker image for untrusted repository commands; build this tag before pressing Execute in the UI.
AGENT_SANDBOX_IMAGE=issue-to-pr-runner:phase3
# Optional: keep runtime SQLite/worktrees somewhere other than .local/ (empty uses .local/).
AGENT_DATA_DIR=
# W4/W5 UI flags are CLI switches, not environment variables:
#   python service_http.py --open
#   python service_http.py --open --fake-publisher  (simulation only; real publish route disabled)
#   python service_http.py --open --real-publisher  (requires GITHUB_TOKEN in the process environment;
#                                                    commits, pushes and creates a Draft PR)
# Optional learned retrieval backends (requires pip install -e ".[rag]")
AGENT_DENSE_MODEL=
AGENT_RERANKER_MODEL=
