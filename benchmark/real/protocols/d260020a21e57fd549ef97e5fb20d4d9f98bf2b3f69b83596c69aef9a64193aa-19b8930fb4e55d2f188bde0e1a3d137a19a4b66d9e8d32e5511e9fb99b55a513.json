  "protocol": {
    "schema_version": 1,
    "strategy": "single",
    "model": {
      "provider": "openai-compatible",
      "name": "deepseek-chat",
      "sampling": {
        "temperature": "provider_default",
        "top_p": "provider_default",
        "seed": null,
        "tool_choice": "provider_default"
      }
    },
    "prompts": {
